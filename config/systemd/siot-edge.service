[Unit]
Description=SIOT Stack Edge IoT (Orange Pi 5 Plus)
Documentation=https://github.com/tu-org/Sistema_Operativo_Tesis_Posgrado
# Dependencias: Docker y red disponibles antes de arrancar
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
# Solo arrancar si existe el compose file
ConditionPathExists=/srv/tesis/repo/docker-compose.edge.yml
ConditionPathExists=/srv/tesis/repo/config/env/domains/edge.env

[Service]
Type=oneshot
RemainAfterExit=yes

# Correr bajo el usuario edge_ops del dominio edge_iot
User=edge_ops
Group=docker
WorkingDirectory=/srv/tesis/repo

# Variables de entorno del dominio
EnvironmentFile=/srv/tesis/repo/config/env/domains/edge.env

# Pre-check: verificar que Docker responde antes de levantar
ExecStartPre=/usr/bin/docker info --format '{{.ServerVersion}}'

# Arranque: levantar el stack edge_iot
ExecStart=/usr/bin/docker compose \
    -f /srv/tesis/repo/docker-compose.edge.yml \
    --project-name siot-edge \
    --env-file /srv/tesis/repo/config/env/domains/edge.env \
    up --detach --remove-orphans --wait

# Detener limpiamente al apagar/reiniciar
ExecStop=/usr/bin/docker compose \
    -f /srv/tesis/repo/docker-compose.edge.yml \
    --project-name siot-edge \
    down --timeout 30

# Recargar configuracion sin downtime
ExecReload=/usr/bin/docker compose \
    -f /srv/tesis/repo/docker-compose.edge.yml \
    --project-name siot-edge \
    --env-file /srv/tesis/repo/config/env/domains/edge.env \
    up --detach --remove-orphans --wait

# Politica de reinicio: siempre, con backoff para proteger el hardware NPU
Restart=always
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=5

# Seguridad: evitar escalacion de privilegios
NoNewPrivileges=yes
PrivateTmp=yes

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=siot-edge

[Install]
WantedBy=multi-user.target
