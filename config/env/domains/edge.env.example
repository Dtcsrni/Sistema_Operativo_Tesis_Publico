# Dominio edge: sin nube por default.
# No cargar llaves de proveedores externos.
SIOT_HUB_URL=http://pc-hub:4000
NODE_ID=orange_pi_5_plus
SYNC_INTERVAL=300
BUFFER_DIR=/app/buffer
SIOT_EDGE_PRIVILEGED=false

# --- Configuracion del Watchdog (T-034) ---
EDGE_IOT_STATE_DIR=/var/lib/edge-iot
EDGE_IOT_LOG_DIR=/var/log/edge-iot
# Healthcheck: Valida que ningun contenedor bajo Docker Compose este 'unhealthy'
EDGE_IOT_HEALTHCHECK_CMD="docker compose -f /srv/tesis/repo/docker-compose.edge.yml ps -q | xargs -r docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}healthy{{end}}' | grep -q 'unhealthy' && exit 1 || exit 0"
EDGE_IOT_MAX_CONSECUTIVE_FAILURES=3
EDGE_IOT_SOFT_FAILURE_RESTART_THRESHOLD=2
EDGE_IOT_BACKOFF_SEC=30
EDGE_IOT_QUARANTINE_SEC=1800
